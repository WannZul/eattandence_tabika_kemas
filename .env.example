# This project reads process/server variables; it does not parse this file.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
# HTTPS origin with optional mount. Session cookie path is derived as / or /eattendance/.
APP_BASE_URL=https://attendance.example.edu.my/eattendance
TRUST_PROXY_HEADERS=false
# Use a distinct name when sibling applications share the same origin.
SESSION_NAME=eattendance_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=face_attendance
DB_USER=eattendance_app
DB_PASSWORD=replace-with-strong-database-password

# HMAC key (minimum 32 chars). Login window is fixed at 15 minutes.
LOGIN_RATE_LIMIT_SECRET=replace-with-independent-random-32-byte-value
LOGIN_PAIR_MAX_ATTEMPTS=5
LOGIN_USERNAME_MAX_ATTEMPTS=20
LOGIN_NETWORK_MAX_ATTEMPTS=30

# Canonical directory served by Apache/Nginx (required in production).
# For a subdirectory install, this is public_html rather than the app folder.
PUBLIC_DOCUMENT_ROOT=/absolute/path/public_html
# Must be outside both PUBLIC_DOCUMENT_ROOT and the application directory.
PRIVATE_STORAGE_PATH=/absolute/private/path/eattendance
# Temporary bootstrap secret; remove after creating the initial administrator.
APP_SETUP_KEY=replace-with-random-32-byte-value

KIOSK_API_KEY=replace-with-independent-random-32-byte-value
# Used by the optional same-PC Windows launch button. If omitted, scan.php
# derives /api/kiosk.php from APP_BASE_URL.
APP_API_URL=https://attendance.example.edu.my/eattendance/api/kiosk.php
LOCAL_KIOSK_ID=tabika-front-desk
FACE_MIN_USABLE_SAMPLES=4
ALLOW_INSECURE_KIOSK_API=false
# Keep false on hosting. Set true only when PHP and the webcam run in the
# same interactive Windows login session.
ALLOW_LOCAL_KIOSK_LAUNCH=false

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Web requests only enqueue this many absence jobs; they never contact Telegram.
TELEGRAM_ENQUEUE_BATCH_SIZE=20
# CLI worker delivery limits.
TELEGRAM_OUTBOX_BATCH_SIZE=5
TELEGRAM_OUTBOX_MAX_ATTEMPTS=6
ALLOW_INSECURE_WEBHOOK=false
